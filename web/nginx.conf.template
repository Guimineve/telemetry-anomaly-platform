# Behind a TLS-terminating ingress this server sees plain HTTP, so trust the scheme the ingress
# reports. It decides HSTS here and the Secure cookie flag in the API (via X-Forwarded-Proto).
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    "" $scheme;
}
map $forwarded_proto $hsts {
    https "max-age=31536000; includeSubDomains";
    default "";  # an empty value means nginx sends no header
}

server {
    listen 8080;
    server_tokens off;
    include /etc/nginx/snippets/security-headers.conf;
    root /usr/share/nginx/html;

    # the API rate-limits logins per client IP and the WebSocket compares Origin with Host,
    # so pass both through instead of nginx's defaults (its own IP and the upstream name)
    location /api/ {
        proxy_pass ${ANALYSIS_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }
    location = /openapi.json { proxy_pass ${ANALYSIS_UPSTREAM}; }
    location /docs { proxy_pass ${ANALYSIS_UPSTREAM}; }

    location /ws/ {
        proxy_pass ${ANALYSIS_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 1h;
    }

    location = /healthz { access_log off; return 200 "ok\n"; }

    # The app bundle has no inline scripts or styles, so it gets a strict policy. /docs is
    # FastAPI's Swagger UI, which loads from a CDN, so it only gets the common headers.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        try_files $uri /index.html;
    }
}
