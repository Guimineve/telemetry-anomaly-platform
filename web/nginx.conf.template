server {
    listen 8080;
    root /usr/share/nginx/html;

    # the API rate-limits logins per client IP and the WebSocket compares Origin with Host,
    # so pass both through instead of nginx's defaults (its own IP and the upstream name)
    location /api/ {
        proxy_pass ${ANALYSIS_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /openapi.json { proxy_pass ${ANALYSIS_UPSTREAM}; }
    location /docs { proxy_pass ${ANALYSIS_UPSTREAM}; }

    location /ws/ {
        proxy_pass ${ANALYSIS_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
    }

    location = /healthz { access_log off; return 200 "ok\n"; }

    location / { try_files $uri /index.html; }
}
